                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Up" Command="{Binding AdjustDurationCommand}" CommandParameter="UnloadingWork|5"/><KeyBinding Key="Down" Command="{Binding AdjustDurationCommand}" CommandParameter="UnloadingWork|-5"/>
                                        <KeyBinding Key="PageUp" Command="{Binding AdjustDurationCommand}" CommandParameter="UnloadingWork|60"/><KeyBinding Key="PageDown" Command="{Binding AdjustDurationCommand}" CommandParameter="UnloadingWork|-60"/>
                                    </TextBox.InputBindings>
                                </TextBox>
