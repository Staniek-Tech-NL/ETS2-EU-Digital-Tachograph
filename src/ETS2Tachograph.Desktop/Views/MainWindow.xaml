                                    <TextBlock Text="{localization:Localize Key=Planner_CargoPickupLabel}" FontSize="10" Foreground="#5F6874"/>
                                    <TextBlock Text="{Binding PickupText}" FontFamily="Consolas" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{localization:Localize Key=Planner_DeliveryArrivalLabel}" FontSize="10" Foreground="#5F6874"/>
