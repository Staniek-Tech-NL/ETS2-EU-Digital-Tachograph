                                        <KeyBinding Key="PageDown" Command="{Binding AdjustDurationCommand}" CommandParameter="DriveToPickup|-60"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PlannerPresetButton}" Content="30m" Command="{Binding SetDurationPresetCommand}" CommandParameter="DriveToPickup|30"/><Button Style="{StaticResource PlannerPresetButton}" Content="1h" Command="{Binding SetDurationPresetCommand}" CommandParameter="DriveToPickup|60"/></StackPanel>
                            </StackPanel>
                            <StackPanel Width="130" Visibility="{Binding IsMarketOffer, Converter={StaticResource BoolToVisibility}}">
