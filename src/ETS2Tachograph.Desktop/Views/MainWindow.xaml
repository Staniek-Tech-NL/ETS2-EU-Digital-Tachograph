                                </Grid>
                            </StackPanel>
                            <StackPanel Width="225">
                                <TextBlock Text="{localization:Localize Key=Planner_DeliveryWindowToLabel}" FontSize="10" Foreground="#5F6874" FontWeight="Bold"/>
