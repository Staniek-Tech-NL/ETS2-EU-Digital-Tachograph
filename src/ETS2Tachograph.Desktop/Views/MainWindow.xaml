<Window x:Class="ETS2Tachograph.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETS2 Digital Tachograph" Height="800" Width="1280"
        MinHeight="680" MinWidth="1080" Background="#F3F5F8" Foreground="#161A20"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121A27"/>
        <SolidColorBrush x:Key="Panel2" Color="#192333"/>
        <SolidColorBrush x:Key="Accent" Color="#55D6BE"/>
        <SolidColorBrush x:Key="Muted" Color="#8D9AAD"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="HotspotButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#243246"/><Setter Property="Foreground" Value="#F5F8FC"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1520"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="4"/></Style>
        <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="6"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#DDE6EF"/><Setter Property="Background" Value="#18395F"/>
            <Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="18,18"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Shell" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Width="195"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="#315D8D"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#244C78"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="#101824"/><Setter Property="Foreground" Value="#DCE5EF"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#253247"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="#101824"/><Setter Property="AlternatingRowBackground" Value="#151F2D"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202C3D"/><Setter Property="Foreground" Value="#AFC0D4"/><Setter Property="Padding" Value="12"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F7F8FA" BorderBrush="#CAD0D8" BorderThickness="0,0,0,1">
            <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="SYSTEM ZARZĄDZANIA TACHOGRAFEM" FontSize="20" FontWeight="Bold"/><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#32A852" Margin="3,5,7,3"/><TextBlock Text="{Binding ConnectionStatus}" Foreground="#278D43"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="ETS2 TACHO" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ApplicationVersion, StringFormat=v{0}}" Foreground="#36546F" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="KIEROWCA / ADMINISTRATOR" Foreground="#717B89" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" TabStripPlacement="Left" Background="#18395F" BorderThickness="0"
                    SelectedIndex="{Binding SelectedMainTabIndex}">
            <TabItem Header="▣  Dashboard">
                <Grid Background="#F3F5F8" TextElement.Foreground="#161A20">
                <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="360"/></Grid.RowDefinitions>
                    <Border Background="White" BorderBrush="#B9C2CD" BorderThickness="1" CornerRadius="10" Margin="0,0,14,12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/></Grid.RowDefinitions>
                            <Border Background="#F7F8FA" BorderBrush="#CDD3DA" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0"><TextBlock Text="BIEŻĄCY PODGLĄD TACHOGRAFU" FontSize="20" FontWeight="Bold" Margin="20,0" VerticalAlignment="Center"/></Border>
                            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="18"><Canvas Width="1220" Height="535">
                                <Image Source="/ETS2Tachograph.Desktop;component/Assets/tachograph-panel.png" Width="1220" Height="535" Stretch="Fill"/>
                                <Border Canvas.Left="328" Canvas.Top="192" Width="570" Height="125" CornerRadius="5" BorderBrush="#71806E" BorderThickness="3" Padding="12,5">
                                    <Border.Background><ImageBrush ImageSource="/ETS2Tachograph.Desktop;component/Assets/lcd-background.png" Stretch="Fill"/></Border.Background>
                                    <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding DeviceLine1}" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Foreground="#111A12"/><TextBlock Grid.Row="1" Text="{Binding DeviceLine2}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="{Binding DeviceLine2Foreground}"/><TextBlock Grid.Row="2" Text="{Binding DeviceLine3}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#111A12"/></Grid>
                                </Border>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="260" Canvas.Top="345" Width="155" Height="58" PreviewMouseLeftButtonDown="Driver1Button_Down" PreviewMouseLeftButtonUp="Driver1Button_Up" ToolTip="Kierowca 1: kliknij, przytrzymaj 3 s aby wyjąć kartę"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="805" Canvas.Top="345" Width="165" Height="58" PreviewMouseLeftButtonDown="Driver2Button_Down" PreviewMouseLeftButtonUp="Driver2Button_Up" ToolTip="Kierowca 2: kliknij, przytrzymaj 3 s aby wyjąć kartę"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="560" Canvas.Top="325" Width="100" Height="55" Command="{Binding DeviceUpCommand}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="565" Canvas.Top="370" Width="100" Height="58" Command="{Binding DeviceOkCommand}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="660" Canvas.Top="365" Width="78" Height="70" Command="{Binding DeviceCancelCommand}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="555" Canvas.Top="410" Width="110" Height="55" Command="{Binding DeviceDownCommand}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="230" Canvas.Top="410" Width="245" Height="60" Command="{Binding InsertCardCommand}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="755" Canvas.Top="410" Width="255" Height="60" Command="{Binding InsertCard2Command}"/>
                            </Canvas></Viewbox>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Border Background="White" BorderBrush="#B9C2CD" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14"><StackPanel><TextBlock Text="SZYBKIE AKCJE" FontSize="19" FontWeight="Bold" Margin="0,0,0,12"/><Button Content="Generuj raport PDF" Command="{Binding ExportPdfCommand}" Background="#E9EDF2" Foreground="#202631"/><Button Content="Odśwież raport" Command="{Binding RefreshReportCommand}" Background="#E9EDF2" Foreground="#202631"/><Button Content="Eksportuj zobowiązania CSV" Command="{Binding ExportCsvCommand}" Background="#E9EDF2" Foreground="#202631"/><Button Content="Raport diagnostyczny" Command="{Binding ExportDiagnosticCommand}" Background="#FFF0C7" Foreground="#202631"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#B9C2CD" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="ALERTY" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Violations}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#FFF1F1" BorderBrush="#E7A0A0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4"><TextBlock Text="{Binding}" Foreground="#A52B2B" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="ROZLICZ OPCJONALNĄ LUKĘ" Command="{Binding OpenOptionalManualEntryCommand}" Visibility="{Binding HasOptionalManualEntryGap, Converter={StaticResource BoolToVisibility}}" Background="#E5A63B" Foreground="#202631" Margin="0,8,0,2"/><TextBlock Text="{Binding ManualEntrySelectionMessage}" Foreground="#36546F" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding ManualEntryQualificationMessage}" Foreground="#27695E" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding OperationStatus}" Foreground="#8A5A00" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#B9C2CD" BorderThickness="1" CornerRadius="10" Margin="0,0,8,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="SLOT 1 - KIEROWCA AKTYWNY" FontSize="18" FontWeight="Bold"/>
                                <Grid Grid.Row="1" Margin="0,9,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Imię i nazwisko:"/><TextBlock Grid.Column="1" Text="{Binding CardOwner}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="Status:" Margin="0,5"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActivityText}" Margin="0,5"/>
                                    <TextBlock Grid.Row="2" Text="Do przerwy jazdy:"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UntilBreak}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Text="Jazda dzienna:" Margin="0,5,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DailyDrivingWithLimit}" Margin="0,5,0,0" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="4" Text="Praca dobowa:" Margin="0,5,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DailyWorkWithLimit}" Margin="0,5,0,0" FontFamily="Consolas" FontWeight="SemiBold"/>
                                </Grid>
                                <Border Grid.Row="2" Background="#F4F7FA" BorderBrush="#CFD8E2" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="OTWARTE" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding CompensationOverview.OpenCount}" FontFamily="Consolas" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="DŁUG" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding CompensationOverview.TotalDebtText}" FontFamily="Consolas" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="NAJBLIŻSZY TERMIN" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding CompensationOverview.NearestDueText}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Text="STATUS" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding CompensationOverview.StatusText}" Foreground="{Binding CompensationOverview.StatusForeground}" FontSize="10" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="3" Background="#EEF3F7" BorderBrush="#CFD8E2" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="WYBRANA PAUZA" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestTargetText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="TRWA" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestElapsed}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="POZOSTAŁO" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestRemaining}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding RestStatus}" FontSize="9" Foreground="#24754D" FontWeight="Bold"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="4" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding RestTargets}" SelectedItem="{Binding SelectedRestTarget, Mode=TwoWay}" DisplayMemberPath="Name" Height="34" Margin="0,0,8,0" Background="White" Foreground="#161A20"/>
                                    <Button Grid.Column="1" Content="ROZPOCZNIJ PAUZĘ" Command="{Binding StartSelectedRestCommand}" Background="#245B94" Padding="13,8" Margin="0"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="White" BorderBrush="#B9C2CD" BorderThickness="1" CornerRadius="10" Margin="8,0,0,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="SLOT 2 - KIEROWCA ZMIENNIK" FontSize="18" FontWeight="Bold"/>
                                <Grid Grid.Row="1" Margin="0,9,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Imię i nazwisko:"/><TextBlock Grid.Column="1" Text="{Binding Card2Owner}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="Status:" Margin="0,5"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Driver2ActivityText}" Margin="0,5"/>
                                    <TextBlock Grid.Row="2" Text="Jazda / do przerwy:"/><TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold"><Run Text="{Binding Driver2ContinuousDriving, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Driver2UntilBreak, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Grid.Row="3" Text="Jazda dzienna:" Margin="0,5,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Driver2DailyDrivingWithLimit}" Margin="0,5,0,0" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="4" Text="Praca dobowa:" Margin="0,5,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Driver2DailyWorkWithLimit}" Margin="0,5,0,0" FontFamily="Consolas" FontWeight="SemiBold"/>
                                </Grid>
                                <Border Grid.Row="2" Background="#F4F7FA" BorderBrush="#CFD8E2" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="OTWARTE" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding Driver2CompensationOverview.OpenCount}" FontFamily="Consolas" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="DŁUG" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding Driver2CompensationOverview.TotalDebtText}" FontFamily="Consolas" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="NAJBLIŻSZY TERMIN" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding Driver2CompensationOverview.NearestDueText}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Text="STATUS" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding Driver2CompensationOverview.StatusText}" Foreground="{Binding Driver2CompensationOverview.StatusForeground}" FontSize="10" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="3" Background="#EEF3F7" BorderBrush="#CFD8E2" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="WYBRANA PAUZA" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestTargetText2}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="TRWA" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestElapsed2}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="POZOSTAŁO" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestRemaining2}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding RestStatus2}" FontSize="9" Foreground="#24754D" FontWeight="Bold"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="4" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding RestTargets}" SelectedItem="{Binding SelectedRestTarget2, Mode=TwoWay}" DisplayMemberPath="Name" IsEnabled="{Binding CanSelectRestTarget2}" Height="34" Margin="0,0,8,0" Background="White" Foreground="#161A20"/>
                                    <Button Grid.Column="1" Content="PAUZA KIEROWCY 2" Command="{Binding StartSelectedRest2Command}" Background="#245B94" Padding="13,8" Margin="0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="▤  Historia">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="HISTORIA AKTYWNOŚCI · WSZYSTKIE KARTY" FontSize="23" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Eksportuj .tacho kierowcy 1" Command="{Binding ExportCommand}"/>
                            <Button Content="Importuj .tacho" Command="{Binding ImportCommand}"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,18,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KARTA" Binding="{Binding DriverCardId}"/>
                            <DataGridTextColumn Header="OD · CZAS GRY" Binding="{Binding StartGameTimeText}"/>
                            <DataGridTextColumn Header="DO · CZAS GRY" Binding="{Binding EndGameTimeText}"/>
                            <DataGridTextColumn Header="AKTYWNOŚĆ" Binding="{Binding Activity}" Width="*"/>
                            <DataGridTextColumn Header="ŹRÓDŁO" Binding="{Binding Source}"/>
                            <DataGridTextColumn Header="WARUNEK" Binding="{Binding Condition}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,18,0,8">
                        <TextBlock Text="{Binding ActivityGapsHeader}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <CheckBox Content="Pokaż rozliczone"
                                  IsChecked="{Binding ShowResolvedGaps}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding ActivityGaps}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KARTA" Binding="{Binding DriverCardId}" Width="150"/>
                            <DataGridTextColumn Header="SLOT" Binding="{Binding SlotText}" Width="55"/>
                            <DataGridTextColumn Header="OD" Binding="{Binding StartGameTimeText}" Width="145"/>
                            <DataGridTextColumn Header="DO" Binding="{Binding EndGameTimeText}" Width="145"/>
                            <DataGridTextColumn Header="DŁUGOŚĆ" Binding="{Binding DurationText}" Width="82"/>
                            <DataGridTextColumn Header="PRZYCZYNA" Binding="{Binding ReasonText}" Width="125"/>
                            <DataGridTemplateColumn Header="STAN" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding OngoingHelpText}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="AKCJA" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ActionText}"
                                                IsEnabled="{Binding IsResolvable}"
                                                Command="{Binding DataContext.ResolveGapFromHistoryCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,5"
                                                Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="▤  Rekompensaty">
                <Grid Margin="24" Background="#F3F5F8" TextElement.Foreground="#161A20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="REKOMPENSATY ODPOCZYNKU TYGODNIOWEGO" FontSize="23" FontWeight="Bold"/>
                            <TextBlock Text="Pełny ślad z historii wybranej karty. Identyfikatory są skrócone wyłącznie na ekranie." Foreground="#5F6874" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding CompensationDetailsHeader}" Foreground="#36546F" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding CompensationDriverProfile}" DisplayMemberPath="DisplayName" Width="250" Height="38" Margin="4" Background="White" Foreground="#161A20"/>
                            <Button Content="ODŚWIEŻ SZCZEGÓŁY" Command="{Binding RefreshCompensationDetailsCommand}" Background="#27695E"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                        <ItemsControl ItemsSource="{Binding CompensationDetails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#C7D0DA" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Background="#315D8D" CornerRadius="5" Padding="8,3" Margin="0,0,10,0"><TextBlock Text="{Binding SlotLabel}" Foreground="White" FontWeight="Bold"/></Border>
                                                <TextBlock Grid.Column="1" Text="{Binding DriverCardId}" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" VerticalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="IDENTYFIKATOR ZOBOWIĄZANIA" Foreground="#5F6874" FontSize="10"/>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ObligationIdShort}" ToolTip="{Binding ObligationId}" FontFamily="Consolas" VerticalAlignment="Center"/><Button Content="KOPIUJ" Command="{Binding DataContext.CopyIdentifierCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding ObligationId}" Padding="8,4" FontSize="10"/></StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="ŹRÓDŁOWY ODPOCZYNEK · KONIEC" Foreground="#5F6874" FontSize="10"/>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SourceRestBlockIdShort}" ToolTip="{Binding SourceRestBlockId}" FontFamily="Consolas" VerticalAlignment="Center"/><Button Content="KOPIUJ" Command="{Binding DataContext.CopyIdentifierCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding SourceRestBlockId}" Padding="8,4" FontSize="10"/><TextBlock Text="{Binding SourceRestEndText}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="PEŁNY DŁUG" Foreground="#5F6874" FontSize="10"/><TextBlock Text="{Binding OriginalDebtText}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/></StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock Text="POZOSTAŁO" Foreground="#5F6874" FontSize="10"/><TextBlock Text="{Binding RemainingDebtText}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="TYDZIEŃ SKRÓCENIA" Foreground="#5F6874" FontSize="10"/><TextBlock Text="{Binding ReductionWeekText}" FontWeight="SemiBold"/></StackPanel>
                                                <StackPanel Grid.Column="3"><TextBlock Text="TERMIN WYŁĄCZNY" Foreground="#5F6874" FontSize="10"/><TextBlock Text="{Binding DueAtText}" FontFamily="Consolas" FontWeight="SemiBold"/></StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="BLOK SPŁACAJĄCY" Foreground="#5F6874" FontSize="10"/>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PaymentRestBlockIdShort}" ToolTip="{Binding PaymentRestBlockId}" FontFamily="Consolas" VerticalAlignment="Center"/><Button Content="KOPIUJ" IsEnabled="{Binding HasPaymentRestBlock}" Command="{Binding DataContext.CopyIdentifierCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding PaymentRestBlockId}" Padding="8,4" FontSize="10"/></StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock Text="ZAKRES MINUT SPŁATY" Foreground="#5F6874" FontSize="10"/><TextBlock Text="{Binding PaymentRangeText}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Moment spłaty (SettledAt)" Foreground="#5F6874"/><TextBlock Grid.Column="1" Text="{Binding SettledAtText}" FontFamily="Consolas" FontWeight="SemiBold"/></Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="▥  Raporty"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Grid><TextBlock Text="RAPORTY I STATYSTYKI" FontSize="23" FontWeight="Bold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CSV ZOBOWIĄZANIA" Command="{Binding ExportCsvCommand}"/><Button Content="PDF" Command="{Binding ExportPdfCommand}" Background="#27695E"/><Button Content="VTC JSON" Command="{Binding ExportVtcCommand}"/></StackPanel></Grid>
                <Border Grid.Row="1" Style="{StaticResource MetricCard}" Margin="0,18,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="KIEROWCA / KARTA" Foreground="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ReportDriverProfile}" DisplayMemberPath="DisplayName" Height="38" Margin="4"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="OD CZASU GRY" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding ReportFrom, UpdateSourceTrigger=PropertyChanged}" ToolTip="Np. Dzień 12, 14:30 · puste oznacza początek historii"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DO CZASU GRY" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding ReportTo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Np. Dzień 12, 18:00 · puste oznacza koniec historii"/></StackPanel><Button Grid.Column="3" Content="GENERUJ RAPORT" Command="{Binding RefreshReportCommand}" Background="#27695E" VerticalAlignment="Bottom"/></Grid></Border>
                <Border Grid.Row="2"
                        Background="#3A251E"
                        BorderBrush="#D76A4A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="6,0,6,6"
                        Visibility="{Binding ReportHasUnresolvedGaps, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ReportGapWarningText}" Foreground="#FFD0C2" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="POKAŻ LUKI" Command="{Binding ShowReportGapsCommand}" Background="#B74E36" Margin="12,0,0,0" Padding="14,7"/>
                    </Grid>
                </Border>
                <UniformGrid Grid.Row="3" Columns="6"><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="JAZDA" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportDriving}" FontFamily="Consolas" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="PRACA" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportWork}" FontFamily="Consolas" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="GOTOWOŚĆ" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportAvailability}" FontFamily="Consolas" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ODPOCZYNEK" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportRest}" FontFamily="Consolas" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="REKOMPENSATA" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportCompensation}" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{Binding ReportCompensationForeground}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="NARUSZENIA" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportViolationCount}" FontFamily="Consolas" FontSize="25" FontWeight="Bold" Foreground="#FF8F8F"/></StackPanel></Border></UniformGrid>
                <DataGrid Grid.Row="4" ItemsSource="{Binding ReportRows}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="KARTA" Binding="{Binding DriverCardId}"/><DataGridTextColumn Header="OD · CZAS GRY" Binding="{Binding StartGameTimeText}"/><DataGridTextColumn Header="DO · CZAS GRY" Binding="{Binding EndGameTimeText}"/><DataGridTextColumn Header="AKTYWNOŚĆ" Binding="{Binding Activity}" Width="*"/><DataGridTextColumn Header="ŹRÓDŁO" Binding="{Binding Source}"/><DataGridTextColumn Header="WARUNEK" Binding="{Binding Condition}"/></DataGrid.Columns></DataGrid>
            </Grid></TabItem>

            <TabItem Header="♙  Kierowcy"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="PROFILE KIEROWCÓW" FontSize="23" FontWeight="Bold"/><DataGrid Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,18"><DataGrid.Columns><DataGridTextColumn Header="KIEROWCA" Binding="{Binding DisplayName}" Width="*"/><DataGridCheckBoxColumn Header="AKTYWNY" Binding="{Binding IsActive}"/><DataGridTextColumn Header="UTWORZONO" Binding="{Binding CreatedAtUtc}"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="NOWY PROFIL" Foreground="{StaticResource Muted}"/><WrapPanel><TextBox Width="240" Text="{Binding NewDriverName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nazwa kierowcy"/><TextBox Width="190" Text="{Binding NewCardNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="Numer karty"/><Button Content="DODAJ" Command="{Binding CreateProfileCommand}" Background="#27695E"/><Button Content="USTAW AKTYWNY" Command="{Binding ActivateProfileCommand}"/></WrapPanel><TextBlock Text="{Binding OperationStatus}" Foreground="#F3C969"/></StackPanel></Border></Grid></TabItem>

            <TabItem Header="⚙  Ustawienia"><StackPanel Margin="28" MaxWidth="650" HorizontalAlignment="Left"><TextBlock Text="USTAWIENIA TACHOGRAFU" FontSize="23" FontWeight="Bold"/><TextBlock Text="Parametry zostaną zastosowane przy następnym uruchomieniu." Foreground="{StaticResource Muted}" Margin="0,7,0,20"/><Border Style="{StaticResource MetricCard}" Width="600"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Próg wykrywania jazdy" FontWeight="SemiBold"/><TextBlock Text="Prędkość, od której tachograf wybiera jazdę automatycznie." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel><TextBox Grid.Column="1" Text="{Binding DrivingThreshold}"/><StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="Przesunięcie tygodnia" FontWeight="SemiBold"/><TextBlock Text="Korekta początku tygodnia regulacyjnego w dniach." Foreground="{StaticResource Muted}"/></StackPanel><TextBox Grid.Row="1" Grid.Column="1" Margin="4,22,4,4" Text="{Binding WeekOffset}"/></Grid></Border><Button Content="ZAPISZ USTAWIENIA" Command="{Binding SaveSettingsCommand}" Background="#27695E" HorizontalAlignment="Left" Padding="22,12"/><TextBlock Text="{Binding OperationStatus}" Foreground="#F3C969" TextWrapping="Wrap"/></StackPanel></TabItem>
        </TabControl>

        <Grid Grid.RowSpan="2" Background="#B0000000" Visibility="{Binding IsCardDialogVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="540" Background="#252B31" BorderBrush="#59636B" BorderThickness="1" CornerRadius="12" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding CardDialogTitle}" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CardDialogMessage}" Margin="0,10,0,18" Foreground="#B8C1C8" TextWrapping="Wrap"/>
                    <Border Background="#C7D3B0" BorderBrush="#7B876A" BorderThickness="3" CornerRadius="5" Padding="16" Margin="0,0,0,16">
                        <StackPanel><TextBlock Text="{Binding CardDialogSlotText}" FontFamily="Consolas" FontWeight="Bold" Foreground="#172016"/><TextBlock Text="{Binding SelectedProfile.DisplayName}" FontFamily="Consolas" FontSize="18" Foreground="#172016" Margin="0,5"/><TextBlock Text="WPIS KRAJU" FontFamily="Consolas" Foreground="#172016"/></StackPanel>
                    </Border>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Dostępna karta" Foreground="#9DA8B0"/><ComboBox ItemsSource="{Binding AvailableCardProfiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" Height="36" Margin="0,5,12,12"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Kod kraju" Foreground="#9DA8B0"/><TextBox Text="{Binding CardCountry, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" Height="36" Margin="0,5,0,12"/></StackPanel></Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="ANULUJ" Command="{Binding CancelCardCommand}"/><Button Content="POTWIERDŹ  OK" Command="{Binding ConfirmCardCommand}" Background="#27695E"/></StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2" Background="#D6000000" Visibility="{Binding IsManualEntryVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="760" MaxHeight="720" Background="#20272F" BorderBrush="#E5A63B" BorderThickness="2" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding ManualEntryTitle}" FontSize="22" FontWeight="Bold" Foreground="#F5F8FC"/>
                        <TextBlock Text="Karta została ponownie włożona. Rozlicz czas, w którym tachograf nie rejestrował aktywności." Foreground="#B8C1C8" TextWrapping="Wrap" Margin="0,8,0,18"/>
                        <Border Background="#C7D3B0" BorderBrush="#71806E" BorderThickness="3" CornerRadius="6" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="WPIS MANUALNY" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#172016"/>
                                <TextBlock Grid.Row="1" Text="{Binding ManualEntryRangeText}" FontFamily="Consolas" FontSize="17" Foreground="#172016" Margin="0,8,0,2"/>
                                <TextBlock Grid.Row="2" Text="{Binding ManualEntryDurationText}" FontFamily="Consolas" FontWeight="Bold" Foreground="#172016"/>
                            </Grid>
                        </Border>

                        <Border Background="#2A3440" CornerRadius="8" Padding="16" Margin="0,16,0,10">
                            <StackPanel>
                                <TextBlock Text="DOMYŚLNIE: CAŁA LUKA = PRZERWA / ODPOCZYNEK" Foreground="#55D6BE" FontWeight="Bold"/>
                                <TextBlock Text="Jeżeli w części tego czasu wykonywano pracę, dodaj jej zakres. Pozostałe minuty automatycznie pozostaną odpoczynkiem." Foreground="#B8C1C8" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Inna praca od" Foreground="#AEB8C1"/><TextBox Text="{Binding ManualEntryWorkFrom, UpdateSourceTrigger=PropertyChanged}" ToolTip="Np. Dzień 12, 14:30"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Inna praca do" Foreground="#AEB8C1"/><TextBox Text="{Binding ManualEntryWorkTo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Np. Dzień 12, 15:30"/></StackPanel>
                                    <Button Grid.Column="2" Content="DODAJ PRACĘ" Command="{Binding AddManualWorkBlockCommand}" Background="#315D8D" VerticalAlignment="Bottom"/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding ManualEntryWorkBlocks}" SelectedItem="{Binding SelectedManualWorkBlock}" AutoGenerateColumns="False" IsReadOnly="True" Height="130" Margin="4,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="OD" Binding="{Binding FromText}" Width="*"/>
                                        <DataGridTextColumn Header="DO" Binding="{Binding ToText}" Width="*"/>
                                        <DataGridTextColumn Header="CZAS" Binding="{Binding DurationText}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="USUŃ ZAZNACZONY BLOK" Command="{Binding RemoveManualWorkBlockCommand}" HorizontalAlignment="Left" Background="#4A5563"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#152D2A" BorderBrush="#27695E" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,4">
                            <StackPanel><TextBlock Text="{Binding ManualEntrySelectionMessage}" Foreground="#D8FFF6" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ManualEntryQualificationMessage}" Foreground="#9FD8CA" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ManualEntryValidationMessage}" Foreground="#FF9A9A" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="ANULUJ" Command="{Binding CancelManualEntryCommand}" Visibility="{Binding CanCancelManualEntry, Converter={StaticResource BoolToVisibility}}" Background="#4A5563"/>
                            <Button Content="OK · ZAPISZ WPIS" Command="{Binding ConfirmManualEntryCommand}" Background="#27695E" FontWeight="Bold" Padding="22,12"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
