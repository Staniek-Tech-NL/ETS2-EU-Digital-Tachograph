                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Hours}" SelectedItem="{Binding WindowEndHour}" ItemStringFormat="{}{0:00}" Height="38" Margin="2,4" TabIndex="11" ToolTip="{localization:Localize Key=Planner_HourTooltip}"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Minutes}" SelectedItem="{Binding WindowEndMinute}" ItemStringFormat="{}{0:00}" Height="38" Margin="2,4" TabIndex="12" ToolTip="{localization:Localize Key=Planner_MinuteTooltip}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Width="115">
                                <TextBlock Text="{localization:Localize Key=Planner_UnloadingLabel}" FontSize="10" Foreground="#5F6874" FontWeight="Bold"/>
