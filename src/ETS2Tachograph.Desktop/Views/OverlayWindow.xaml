<Window x:Class="ETS2Tachograph.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:ETS2Tachograph.Desktop.Localization"
        Title="{Binding WindowTitle}"
        Width="455" Height="294" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False">
    <Border Margin="8" Padding="16" CornerRadius="10" BorderBrush="#5F7894" BorderThickness="1" Background="#E6111924">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="4" Opacity="0.7"/></Border.Effect>
        <Grid TextElement.Foreground="White">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" ToolTip="{localization:Localize Key=Overlay_DragTooltip}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Padding="6,2" Margin="0,0,9,0" Background="#2B9BE8" CornerRadius="4">
                    <TextBlock Text="{Binding SlotLabel}" FontWeight="Bold" Foreground="White"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#36D783" Margin="0,2,8,0"/>
                    <TextBlock Text="{localization:Localize Key=Overlay_ProductName}" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#64798D" FontSize="9"><Run Text="{localization:Localize Key=Overlay_DragLabel}"/><Run Text="  ·  "/></TextBlock>
                    <TextBlock Text="{Binding HotkeyLabel}" Foreground="#91A4B7" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding ActivityText}" FontSize="22" FontWeight="Bold" Margin="0,10,0,8"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{localization:Localize Key=Overlay_ContinuousDrivingHeader}" Foreground="#91A4B7" FontSize="10"/><TextBlock Text="{Binding ContinuousDriving}" FontFamily="Consolas" FontSize="20" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{localization:Localize Key=Overlay_TimeToBreakHeader}" Foreground="#91A4B7" FontSize="10"/><TextBlock Text="{Binding UntilBreak}" FontFamily="Consolas" FontSize="20" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="{localization:Localize Key=Overlay_DailyDrivingLimitHeader}" Foreground="#91A4B7" FontSize="10"/><TextBlock Text="{Binding DailyDriving}" FontFamily="Consolas" FontSize="16" FontWeight="Bold"/></StackPanel>
            </Grid>
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{localization:Localize Key=Overlay_RestTargetHeader}" Foreground="#91A4B7" FontSize="10"/><TextBlock Text="{Binding RestTargetText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{localization:Localize Key=Overlay_RestElapsedHeader}" Foreground="#91A4B7" FontSize="10"/><TextBlock Text="{Binding RestElapsed}" FontFamily="Consolas" FontSize="19" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="{localization:Localize Key=Dashboard_RemainingLabel}" Foreground="#91A4B7" FontSize="10"/><TextBlock Text="{Binding RestRemaining}" FontFamily="Consolas" FontSize="19" FontWeight="Bold"/><TextBlock Text="{Binding RestStatus}" Foreground="#65E6A5" FontSize="9" FontWeight="Bold"/></StackPanel>
            </Grid>
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{localization:Localize Key=Overlay_DailyDutyHeader}" Foreground="#91A4B7" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DailyWork}" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="12,0,0,0"/>
            </Grid>
            <Grid Grid.Row="5" Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{localization:Localize Key=CompensationSummary_OpenHeader}" Foreground="#91A4B7" FontSize="9"/><TextBlock Text="{Binding CompensationOverview.OpenCount}" FontFamily="Consolas" FontSize="13" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{localization:Localize Key=CompensationSummary_DebtHeader}" Foreground="#91A4B7" FontSize="9"/><TextBlock Text="{Binding CompensationOverview.TotalDebtText}" FontFamily="Consolas" FontSize="13" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="{localization:Localize Key=CompensationSummary_CompleteBeforeHeader}" Foreground="#91A4B7" FontSize="9"/><TextBlock Text="{Binding CompensationOverview.NearestDueCompactText}" ToolTip="{Binding CompensationOverview.NearestDueText}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="{localization:Localize Key=Common_StatusHeader}" Foreground="#91A4B7" FontSize="9"/><TextBlock Text="{Binding CompensationOverview.StatusText}" Foreground="{Binding CompensationOverview.StatusForeground}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
            </Grid>
            <Grid Grid.Row="6" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ModesText}" Foreground="#F0C66B" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}" Foreground="#91A4B7" FontSize="11"/></Grid>
        </Grid>
    </Border>
</Window>
