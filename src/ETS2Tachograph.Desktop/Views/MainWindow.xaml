                                  HeadersVisibility="Column" Margin="0,0,12,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SEGMENT" Binding="{Binding Type}" Width="120"/>
                                <DataGridTextColumn Header="OD" Binding="{Binding Start}" Width="110"/>
                                <DataGridTextColumn Header="DO" Binding="{Binding End}" Width="110"/>
