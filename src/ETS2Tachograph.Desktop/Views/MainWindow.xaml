                        </Border>

                        <StackPanel Grid.Row="1" Margin="2,9,2,5">
                            <TextBlock Text="{localization:Localize Key=ManualEntry_QuickChoiceTitle}" Foreground="#3DD2B5" FontWeight="Bold"/>
                            <TextBlock Text="{localization:Localize Key=ManualEntry_QuickChoiceHelp}" Foreground="#AEB8C1" FontSize="11" Margin="0,2,0,3"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="{localization:Localize Key=ManualEntry_BreakOrRestAction}" Command="{Binding SetWholeManualEntryRestCommand}"
                                        Background="#126358" BorderBrush="#26C7AD" BorderThickness="1"/>
                                <Button Grid.Column="1" Content="{localization:Localize Key=ActivityUpper_OtherWork}" Command="{Binding SetWholeManualEntryWorkCommand}"
                                        Background="#245B88" BorderBrush="#4A94CE" BorderThickness="1"/>
                                <Button Grid.Column="2" Content="{localization:Localize Key=ActivityUpper_Availability}" Command="{Binding SetWholeManualEntryAvailabilityCommand}"
                                        Background="#453D5E" BorderBrush="#8072A1" BorderThickness="1"/>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="2" Background="#263A4C" BorderBrush="#5A7186" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,3">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="{localization:Localize Key=ManualEntry_PlanTitle}" Foreground="#F5F8FC" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="#172A3A" BorderBrush="#6E8AA1" BorderThickness="1"
                                            CornerRadius="14" Padding="14,4">
                                        <TextBlock Text="{Binding ManualEntrySegmentCountText}" Foreground="#D5E1EC" FontSize="11"/>
                                    </Border>
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding ManualEntrySegments}"
                                          SelectedItem="{Binding SelectedManualEntrySegment}"
                                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                          Margin="0,4,0,0" MouseDoubleClick="ManualEntryPlan_DoubleClick">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="{Binding ActivityBackground}"/>
                                            <Setter Property="Foreground" Value="#F1F6FA"/>
                                            <Setter Property="BorderBrush" Value="#557086"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                <DataGridTextColumn Header="{localization:Localize Key=Common_From}" Binding="{Binding FromText}" Width="1.1*"/>
                                <DataGridTextColumn Header="{localization:Localize Key=Common_To}" Binding="{Binding ToText}" Width="1.1*"/>
                                        <DataGridTextColumn Header="{localization:Localize Key=Common_ActivityHeader}" Binding="{Binding ActivityText}" Width="1.8*"/>
                                        <DataGridTextColumn Header="{localization:Localize Key=ManualEntry_TimeHeader}" Binding="{Binding DurationText}" Width="85"/>
                                <DataGridTemplateColumn Header="{localization:Localize Key=Common_ActionsHeader}" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                <Button Content="{localization:Localize Key=Common_EditAction}"
                                                                Command="{Binding DataContext.EditManualEntrySegmentCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                CommandParameter="{Binding}" Background="#285E91" Padding="12,5" Margin="2"/>
                                                <Button Content="{localization:Localize Key=Common_RemoveAction}"
                                                                Command="{Binding DataContext.RemoveManualEntrySegmentCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                CommandParameter="{Binding}" Background="#7A2929" Padding="12,5" Margin="2"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="#263A4C" BorderBrush="#5A7186" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,5">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding ManualEntryEditorTitle}" FontSize="16" FontWeight="Bold" Foreground="#F5F8FC"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*"/><ColumnDefinition/><ColumnDefinition Width="92"/>
                                        <ColumnDefinition/><ColumnDefinition Width="92"/><ColumnDefinition Width="82"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{localization:Localize Key=Common_ActivityHeader}" Foreground="#AFC0D4" FontSize="11" FontWeight="Bold"/>
                                        <ComboBox ItemsSource="{Binding ManualEntryActivities}" SelectedItem="{Binding SelectedManualEntryActivity}"
                                                  DisplayMemberPath="DisplayName" Background="White" Foreground="#111111" Padding="8,6" Margin="0,3,8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{localization:Localize Key=ManualEntry_FromDayLabel}" Foreground="#AFC0D4" FontSize="11" FontWeight="Bold"/>
                                        <ComboBox ItemsSource="{Binding ManualEntryDayOptions}" SelectedItem="{Binding ManualEntryFromDay}"
                                                  DisplayMemberPath="DisplayName" Background="White" Foreground="#111111" Padding="8,6" Margin="0,3,8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{localization:Localize Key=ManualEntry_HourLabel}" Foreground="#AFC0D4" FontSize="11" FontWeight="Bold"/>
                                        <TextBox Text="{Binding ManualEntryFromTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,8,0" Padding="8,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{localization:Localize Key=ManualEntry_ToDayLabel}" Foreground="#AFC0D4" FontSize="11" FontWeight="Bold"/>
                                        <ComboBox ItemsSource="{Binding ManualEntryDayOptions}" SelectedItem="{Binding ManualEntryToDay}"
                                                  DisplayMemberPath="DisplayName" Background="White" Foreground="#111111" Padding="8,6" Margin="0,3,8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{localization:Localize Key=ManualEntry_HourLabel}" Foreground="#AFC0D4" FontSize="11" FontWeight="Bold"/>
                                        <TextBox Text="{Binding ManualEntryToTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,8,0" Padding="8,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="5">
                                        <TextBlock Text="{localization:Localize Key=ManualEntry_TimeHeader}" Foreground="#AFC0D4" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ManualEntryFormDurationText}" Foreground="#F5F8FC" FontFamily="Consolas" FontWeight="Bold" Margin="10,11,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Button Content="{Binding ManualEntryApplyButtonText}" Command="{Binding ApplyManualEntrySegmentCommand}"
                                            HorizontalAlignment="Left" Background="#3979B5" Padding="12,6" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding ManualEntryValidationMessage}" Foreground="#FF9A9A" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="470"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Background="#12483F" BorderBrush="#35B89F" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,3,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="25"/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="{localization:Localize Key=ManualEntry_SummaryTitle}" Foreground="#38C7AD" FontWeight="Bold"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="#C9D7DF" FontWeight="SemiBold">
                                            <Run Text="{localization:Localize Key=ManualEntry_CoverageLabel}"/><Run Text="  "/><Run Text="{Binding ManualEntryCoverageText, Mode=OneWay}" FontFamily="Consolas"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ManualEntryCoverageDetails}" Foreground="#9FBAB7" FontSize="10" Margin="12,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#37AC86" CornerRadius="10" Height="18">
                                        <TextBlock Text="{Binding ManualEntryCompletionText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Foreground="#D7E5E6"><Run Text="{localization:Localize Key=ActivityUpper_Rest}"/><Run Text="  "/><Run Text="{Binding ManualEntryRestTotal, Mode=OneWay}" Foreground="#42D3BA" FontFamily="Consolas"/></TextBlock>
                                    <TextBlock Grid.Column="1" Foreground="#D7E5E6"><Run Text="{localization:Localize Key=ActivityUpper_OtherWork}"/><Run Text="  "/><Run Text="{Binding ManualEntryWorkTotal, Mode=OneWay}" Foreground="#4D9FE7" FontFamily="Consolas"/></TextBlock>
                                    <TextBlock Grid.Column="2" Foreground="#D7E5E6"><Run Text="{localization:Localize Key=ActivityUpper_Availability}"/><Run Text="  "/><Run Text="{Binding ManualEntryAvailabilityTotal, Mode=OneWay}" Foreground="#B29ADE" FontFamily="Consolas"/></TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="#17222D" BorderBrush="#405262" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="18,8">
                        <Grid>
                            <Button Content="{localization:Localize Key=ManualEntry_RestoreDefaultAction}" Command="{Binding ResetManualEntryCommand}"
                                    HorizontalAlignment="Left" Background="#34495D"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{localization:Localize Key=Common_CancelAction}" Command="{Binding CancelManualEntryCommand}"
                                        Visibility="{Binding CanCancelManualEntry, Converter={StaticResource BoolToVisibility}}"
                                        Background="#526174"/>
                                <Button Content="{localization:Localize Key=ManualEntry_ConfirmAction}" Command="{Binding ConfirmManualEntryCommand}"
                                        Background="#176A53" FontWeight="Bold" Padding="22,10"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
