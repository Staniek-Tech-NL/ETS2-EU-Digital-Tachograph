                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PlannerPresetButton}" Content="15m" Command="{Binding SetDurationPresetCommand}" CommandParameter="PostDeliveryWork|15"/><Button Style="{StaticResource PlannerPresetButton}" Content="30m" Command="{Binding SetDurationPresetCommand}" CommandParameter="PostDeliveryWork|30"/></StackPanel>
                            </StackPanel>
                            <StackPanel Width="125">
                                <TextBlock Text="{localization:Localize Key=Planner_TightThresholdLabel}" FontSize="10" Foreground="#5F6874" FontWeight="Bold"/>
