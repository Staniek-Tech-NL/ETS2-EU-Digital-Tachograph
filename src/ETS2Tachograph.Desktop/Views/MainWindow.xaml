                                    Background="#27695E" Padding="22,11" VerticalAlignment="Bottom" Margin="12,4,4,4"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#B3261E"
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <Border Background="#EAF2F8" BorderBrush="#9EB6CB" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,6,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="WYNIK" FontSize="10" Foreground="#5F6874"/>
                                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" TextWrapping="Wrap"/>
                                </StackPanel>
