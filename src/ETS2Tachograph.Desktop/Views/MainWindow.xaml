                                            </Grid>
                                            <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{localization:Localize Key=Compensation_SettledAtLabel}" Foreground="#5F6874"/><TextBlock Grid.Column="1" Text="{Binding SettledAtText}" FontFamily="Consolas" FontWeight="SemiBold"/></Grid>
