                                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{localization:Localize Key=Compensation_ObligationIdHeader}" Foreground="#5F6874" FontSize="10"/>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ObligationIdShort}" ToolTip="{Binding ObligationId}" FontFamily="Consolas" VerticalAlignment="Center"/><Button Content="{localization:Localize Key=Common_CopyAction}" Command="{Binding DataContext.CopyIdentifierCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding ObligationId}" Padding="8,4" FontSize="10"/></StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{localization:Localize Key=Compensation_SourceRestEndHeader}" Foreground="#5F6874" FontSize="10"/>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SourceRestBlockIdShort}" ToolTip="{Binding SourceRestBlockId}" FontFamily="Consolas" VerticalAlignment="Center"/><Button Content="{localization:Localize Key=Common_CopyAction}" Command="{Binding DataContext.CopyIdentifierCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding SourceRestBlockId}" Padding="8,4" FontSize="10"/><TextBlock Text="{Binding SourceRestEndText}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{localization:Localize Key=Compensation_OriginalDebtHeader}" Foreground="#5F6874" FontSize="10"/><TextBlock Text="{Binding OriginalDebtText}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/></StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock Text="{localization:Localize Key=Dashboard_RemainingLabel}" Foreground="#5F6874" FontSize="10"/><TextBlock Text="{Binding RemainingDebtText}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="{localization:Localize Key=Compensation_ReductionWeekHeader}" Foreground="#5F6874" FontSize="10"/><TextBlock Text="{Binding ReductionWeekText}" FontWeight="SemiBold"/></StackPanel>
