                                    <TextBlock Text="WIARYGODNOŚĆ" FontSize="10" Foreground="#5F6874"/>
                                    <TextBlock Text="{Binding ConfidenceText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PRZYJAZD" FontSize="10" Foreground="#5F6874"/>
                                    <TextBlock Text="{Binding ArrivalText}" FontFamily="Consolas" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="KONIEC DOSTAWY" FontSize="10" Foreground="#5F6874"/>
                                    <TextBlock Text="{Binding CompletionText}" FontFamily="Consolas" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="MARGINES" FontSize="10" Foreground="#5F6874"/>
                                    <TextBlock Text="{Binding MarginText}" FontFamily="Consolas" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3">
