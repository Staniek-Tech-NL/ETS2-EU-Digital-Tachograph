<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <!-- Keep assembly identity stable within the 1.x line; file and product fields
         identify the exact release the binary came from. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>
</Project>
