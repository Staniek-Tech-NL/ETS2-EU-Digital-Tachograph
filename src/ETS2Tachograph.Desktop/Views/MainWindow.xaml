                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PlannerPresetButton}" Content="15m" Command="{Binding SetDurationPresetCommand}" CommandParameter="PickupWork|15"/><Button Style="{StaticResource PlannerPresetButton}" Content="30m" Command="{Binding SetDurationPresetCommand}" CommandParameter="PickupWork|30"/></StackPanel>
                            </StackPanel>
                            <StackPanel Width="135">
                                <TextBlock Text="{localization:Localize Key=Planner_LoadedRouteLabel}" FontSize="10" Foreground="#5F6874" FontWeight="Bold"/>
