                            </StackPanel>
                            <StackPanel Width="150"><TextBlock Text="{localization:Localize Key=Planner_FirstDriverLabel}" FontSize="10" Foreground="#5F6874" FontWeight="Bold"/><ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" DisplayMemberPath="Name" Height="38" Margin="4" TabIndex="2"/></StackPanel>
