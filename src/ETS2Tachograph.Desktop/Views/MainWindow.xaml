                                <TextBox Style="{StaticResource PlannerDurationInput}" TabIndex="5" Text="{Binding PickupWork, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Up" Command="{Binding AdjustDurationCommand}" CommandParameter="PickupWork|5"/><KeyBinding Key="Down" Command="{Binding AdjustDurationCommand}" CommandParameter="PickupWork|-5"/>
                                        <KeyBinding Key="PageUp" Command="{Binding AdjustDurationCommand}" CommandParameter="PickupWork|60"/><KeyBinding Key="PageDown" Command="{Binding AdjustDurationCommand}" CommandParameter="PickupWork|-60"/>
                                    </TextBox.InputBindings>
