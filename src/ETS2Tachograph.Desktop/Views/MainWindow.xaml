<Window x:Class="ETS2Tachograph.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ETS2Tachograph.Desktop"
        xmlns:localization="clr-namespace:ETS2Tachograph.Desktop.Localization"
        Title="{localization:Localize Key=Shell_ProductName}" Height="800" Width="1280"
        MinHeight="680" MinWidth="1080" Background="#F3F5F8" Foreground="#161A20"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121A27"/>
        <SolidColorBrush x:Key="Panel2" Color="#192333"/>
        <SolidColorBrush x:Key="Accent" Color="#55D6BE"/>
        <SolidColorBrush x:Key="Muted" Color="#8D9AAD"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:LocalDateTimeConverter x:Key="LocalDateTimeConverter"/>
        <Style x:Key="HotspotButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#243246"/><Setter Property="Foreground" Value="#F5F8FC"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1520"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="4"/></Style>
        <Style x:Key="PlannerDurationInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <EventSetter Event="PreviewKeyDown" Handler="PlannerDuration_PreviewKeyDown"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#D92D20"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlannerPresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#315D8D"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="6"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#DDE6EF"/><Setter Property="Background" Value="#18395F"/>
            <Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="18,18"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Shell" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Width="195"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="#315D8D"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#244C78"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="#101824"/><Setter Property="Foreground" Value="#DCE5EF"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#253247"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="#101824"/><Setter Property="AlternatingRowBackground" Value="#151F2D"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202C3D"/><Setter Property="Foreground" Value="#AFC0D4"/><Setter Property="Padding" Value="12"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelManualEntryCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F7F8FA" BorderBrush="#CAD0D8" BorderThickness="0,0,0,1">
            <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="{localization:Localize Key=Shell_SystemTitle}" FontSize="20" FontWeight="Bold"/><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#32A852" Margin="3,5,7,3"/><TextBlock Text="{Binding ConnectionStatus}" Foreground="#278D43"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="ETS2 TACHO" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ApplicationVersionText}" Foreground="#36546F" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{localization:Localize Key=Shell_DriverAdministratorRole}" Foreground="#717B89" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" TabStripPlacement="Left" Background="#18395F" BorderThickness="0"
                    SelectedIndex="{Binding SelectedMainTabIndex}">
            <TabItem>
                <TabItem.Header><TextBlock><Run Text="▣  "/><Run Text="{localization:Localize Key=Navigation_Dashboard}"/></TextBlock></TabItem.Header>
                <Grid Background="#F3F5F8" TextElement.Foreground="#161A20">
                <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="360"/></Grid.RowDefinitions>
                    <Border Background="White" BorderBrush="#B9C2CD" BorderThickness="1" CornerRadius="10" Margin="0,0,14,12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/></Grid.RowDefinitions>
                            <Border Background="#F7F8FA" BorderBrush="#CDD3DA" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0"><TextBlock Text="{localization:Localize Key=Device_CurrentViewTitle}" FontSize="20" FontWeight="Bold" Margin="20,0" VerticalAlignment="Center"/></Border>
                            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="18"><Canvas Width="1220" Height="535">
                                <Image Source="/ETS2Tachograph.Desktop;component/Assets/tachograph-panel.png" Width="1220" Height="535" Stretch="Fill"/>
                                <Border Canvas.Left="328" Canvas.Top="192" Width="570" Height="125" CornerRadius="5" BorderBrush="#71806E" BorderThickness="3" Padding="12,5">
                                    <Border.Background><ImageBrush ImageSource="/ETS2Tachograph.Desktop;component/Assets/lcd-background.png" Stretch="Fill"/></Border.Background>
                                    <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding DeviceLine1}" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Foreground="#111A12"/><TextBlock Grid.Row="1" Text="{Binding DeviceLine2}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="{Binding DeviceLine2Foreground}"/><TextBlock Grid.Row="2" Text="{Binding DeviceLine3}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#111A12"/></Grid>
                                </Border>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="260" Canvas.Top="345" Width="155" Height="58" PreviewMouseLeftButtonDown="Driver1Button_Down" PreviewMouseLeftButtonUp="Driver1Button_Up" ToolTip="{Binding Driver1ButtonTooltip}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="805" Canvas.Top="345" Width="165" Height="58" PreviewMouseLeftButtonDown="Driver2Button_Down" PreviewMouseLeftButtonUp="Driver2Button_Up" ToolTip="{Binding Driver2ButtonTooltip}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="560" Canvas.Top="325" Width="100" Height="55" Command="{Binding DeviceUpCommand}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="565" Canvas.Top="370" Width="100" Height="58" Command="{Binding DeviceOkCommand}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="660" Canvas.Top="365" Width="78" Height="70" Command="{Binding DeviceCancelCommand}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="555" Canvas.Top="410" Width="110" Height="55" Command="{Binding DeviceDownCommand}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="230" Canvas.Top="410" Width="245" Height="60" Command="{Binding InsertCardCommand}"/>
                                <Button Style="{StaticResource HotspotButton}" Canvas.Left="755" Canvas.Top="410" Width="255" Height="60" Command="{Binding InsertCard2Command}"/>
                            </Canvas></Viewbox>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Border Background="White" BorderBrush="#B9C2CD" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14"><StackPanel><TextBlock Text="{localization:Localize Key=Dashboard_QuickActionsTitle}" FontSize="19" FontWeight="Bold" Margin="0,0,0,12"/><Button Content="{localization:Localize Key=Dashboard_GeneratePdfAction}" Command="{Binding ExportPdfCommand}" Background="#E9EDF2" Foreground="#202631"/><Button Content="{localization:Localize Key=Dashboard_RefreshReportAction}" Command="{Binding RefreshReportCommand}" Background="#E9EDF2" Foreground="#202631"/><Button Content="{localization:Localize Key=Dashboard_ExportObligationsCsvAction}" Command="{Binding ExportCsvCommand}" Background="#E9EDF2" Foreground="#202631"/><Button Content="{localization:Localize Key=Dashboard_DiagnosticReportAction}" Command="{Binding ExportDiagnosticCommand}" Background="#FFF0C7" Foreground="#202631"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#B9C2CD" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="{localization:Localize Key=Dashboard_AlertsTitle}" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Violations}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#FFF1F1" BorderBrush="#E7A0A0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4"><TextBlock Text="{Binding}" Foreground="#A52B2B" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="{localization:Localize Key=Dashboard_ResolveOptionalGapAction}" Command="{Binding OpenOptionalManualEntryCommand}" Visibility="{Binding HasOptionalManualEntryGap, Converter={StaticResource BoolToVisibility}}" Background="#E5A63B" Foreground="#202631" Margin="0,8,0,2"/><TextBlock Text="{Binding ManualEntrySelectionMessage}" Foreground="#36546F" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding ManualEntryQualificationMessage}" Foreground="#27695E" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding OperationStatus}" Foreground="#8A5A00" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#B9C2CD" BorderThickness="1" CornerRadius="10" Margin="0,0,8,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="{localization:Localize Key=Dashboard_Slot1Title}" FontSize="18" FontWeight="Bold"/>
                                <Grid Grid.Row="1" Margin="0,9,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="{localization:Localize Key=Dashboard_DriverNameLabel}"/><TextBlock Grid.Column="1" Text="{Binding CardOwner}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="{localization:Localize Key=Dashboard_ActivityStatusLabel}" Margin="0,5"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActivityText}" Margin="0,5"/>
                                    <TextBlock Grid.Row="2" Text="{localization:Localize Key=Dashboard_TimeUntilBreakLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UntilBreak}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Text="{localization:Localize Key=Dashboard_DailyDrivingLabel}" Margin="0,5,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DailyDrivingWithLimit}" Margin="0,5,0,0" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="4" Text="{localization:Localize Key=Dashboard_DailyDutyLabel}" Margin="0,5,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DailyWorkWithLimit}" Margin="0,5,0,0" FontFamily="Consolas" FontWeight="SemiBold"/>
                                </Grid>
                                <Border Grid.Row="2" Background="#F4F7FA" BorderBrush="#CFD8E2" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{localization:Localize Key=CompensationSummary_OpenHeader}" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding CompensationOverview.OpenCount}" FontFamily="Consolas" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{localization:Localize Key=CompensationSummary_DebtHeader}" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding CompensationOverview.TotalDebtText}" FontFamily="Consolas" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="{localization:Localize Key=CompensationSummary_CompleteBeforeHeader}" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding CompensationOverview.NearestDueCompactText}" ToolTip="{Binding CompensationOverview.NearestDueText}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Text="{localization:Localize Key=Common_StatusHeader}" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding CompensationOverview.StatusText}" Foreground="{Binding CompensationOverview.StatusForeground}" FontSize="10" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="3" Background="#EEF3F7" BorderBrush="#CFD8E2" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{localization:Localize Key=Dashboard_SelectedBreakLabel}" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestTargetText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{localization:Localize Key=Dashboard_ElapsedLabel}" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestElapsed}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="{localization:Localize Key=Dashboard_RemainingLabel}" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestRemaining}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding RestStatus}" FontSize="9" Foreground="#24754D" FontWeight="Bold"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="4" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding RestTargets}" SelectedItem="{Binding SelectedRestTarget, Mode=TwoWay}" DisplayMemberPath="Name" Height="34" Margin="0,0,8,0" Background="White" Foreground="#161A20"/>
                                    <Button Grid.Column="1" Content="{localization:Localize Key=Dashboard_StartBreakAction}" Command="{Binding StartSelectedRestCommand}" Background="#245B94" Padding="13,8" Margin="0"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="White" BorderBrush="#B9C2CD" BorderThickness="1" CornerRadius="10" Margin="8,0,0,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="{localization:Localize Key=Dashboard_Slot2Title}" FontSize="18" FontWeight="Bold"/>
                                <Grid Grid.Row="1" Margin="0,9,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="{localization:Localize Key=Dashboard_DriverNameLabel}"/><TextBlock Grid.Column="1" Text="{Binding Card2Owner}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="{localization:Localize Key=Dashboard_ActivityStatusLabel}" Margin="0,5"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Driver2ActivityText}" Margin="0,5"/>
                                    <TextBlock Grid.Row="2" Text="{localization:Localize Key=Dashboard_DrivingAndTimeUntilBreakLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold"><Run Text="{Binding Driver2ContinuousDriving, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Driver2UntilBreak, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Grid.Row="3" Text="{localization:Localize Key=Dashboard_DailyDrivingLabel}" Margin="0,5,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Driver2DailyDrivingWithLimit}" Margin="0,5,0,0" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="4" Text="{localization:Localize Key=Dashboard_DailyDutyLabel}" Margin="0,5,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Driver2DailyWorkWithLimit}" Margin="0,5,0,0" FontFamily="Consolas" FontWeight="SemiBold"/>
                                </Grid>
                                <Border Grid.Row="2" Background="#F4F7FA" BorderBrush="#CFD8E2" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{localization:Localize Key=CompensationSummary_OpenHeader}" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding Driver2CompensationOverview.OpenCount}" FontFamily="Consolas" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{localization:Localize Key=CompensationSummary_DebtHeader}" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding Driver2CompensationOverview.TotalDebtText}" FontFamily="Consolas" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="{localization:Localize Key=CompensationSummary_CompleteBeforeHeader}" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding Driver2CompensationOverview.NearestDueCompactText}" ToolTip="{Binding Driver2CompensationOverview.NearestDueText}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Text="{localization:Localize Key=Common_StatusHeader}" FontSize="9" Foreground="#5F6874"/><TextBlock Text="{Binding Driver2CompensationOverview.StatusText}" Foreground="{Binding Driver2CompensationOverview.StatusForeground}" FontSize="10" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="3" Background="#EEF3F7" BorderBrush="#CFD8E2" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{localization:Localize Key=Dashboard_SelectedBreakLabel}" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestTargetText2}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{localization:Localize Key=Dashboard_ElapsedLabel}" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestElapsed2}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="{localization:Localize Key=Dashboard_RemainingLabel}" FontSize="10" Foreground="#5F6874"/><TextBlock Text="{Binding RestRemaining2}" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding RestStatus2}" FontSize="9" Foreground="#24754D" FontWeight="Bold"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="4" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding RestTargets}" SelectedItem="{Binding SelectedRestTarget2, Mode=TwoWay}" DisplayMemberPath="Name" IsEnabled="{Binding CanSelectRestTarget2}" Height="34" Margin="0,0,8,0" Background="White" Foreground="#161A20"/>
                                    <Button Grid.Column="1" Content="{localization:Localize Key=Dashboard_StartCoDriverBreakAction}" Command="{Binding StartSelectedRest2Command}" Background="#245B94" Padding="13,8" Margin="0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header><TextBlock><Run Text="▤  "/><Run Text="{localization:Localize Key=Navigation_History}"/></TextBlock></TabItem.Header>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{localization:Localize Key=History_Title}" FontSize="23" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{localization:Localize Key=History_ExportDriver1TachoAction}" Command="{Binding ExportCommand}"/>
                            <Button Content="{localization:Localize Key=History_ImportTachoAction}" Command="{Binding ImportCommand}"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,18,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{localization:Localize Key=History_CardHeader}" Binding="{Binding DriverCardId}"/>
                            <DataGridTextColumn Header="{localization:Localize Key=History_FromGameTimeHeader}" Binding="{Binding StartGameTimeText}"/>
                            <DataGridTextColumn Header="{localization:Localize Key=History_ToGameTimeHeader}" Binding="{Binding EndGameTimeText}"/>
                            <DataGridTextColumn Header="{localization:Localize Key=Common_ActivityHeader}" Binding="{Binding ActivityText}" Width="*"/>
                                        <DataGridTextColumn Header="{localization:Localize Key=Common_SourceHeader}" Binding="{Binding SourceText}"/>
                            <DataGridTextColumn Header="{localization:Localize Key=History_ConditionHeader}" Binding="{Binding ConditionText}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,18,0,8">
                        <TextBlock Text="{Binding ActivityGapsHeader}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <CheckBox Content="{localization:Localize Key=Gap_ShowResolved}"
                                  IsChecked="{Binding ShowResolvedGaps}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding ActivityGaps}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{localization:Localize Key=History_CardHeader}" Binding="{Binding DriverCardId}" Width="150"/>
                            <DataGridTextColumn Header="{localization:Localize Key=Gap_SlotHeader}" Binding="{Binding SlotText}" Width="55"/>
                                        <DataGridTextColumn Header="{localization:Localize Key=Common_From}" Binding="{Binding StartGameTimeText}" Width="145"/>
                                        <DataGridTextColumn Header="{localization:Localize Key=Common_To}" Binding="{Binding EndGameTimeText}" Width="145"/>
                            <DataGridTextColumn Header="{localization:Localize Key=Gap_DurationHeader}" Binding="{Binding DurationText}" Width="82"/>
                            <DataGridTextColumn Header="{localization:Localize Key=Gap_CauseHeader}" Binding="{Binding ReasonText}" Width="125"/>
                            <DataGridTemplateColumn Header="{localization:Localize Key=Gap_StateHeader}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding OngoingHelpText}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{localization:Localize Key=Common_ActionHeader}" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ActionText}"
                                                IsEnabled="{Binding IsResolvable}"
                                                Command="{Binding DataContext.ResolveGapFromHistoryCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,5"
                                                Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem>
