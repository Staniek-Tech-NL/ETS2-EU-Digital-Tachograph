                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ObligationIdShort}" ToolTip="{Binding ObligationId}" FontFamily="Consolas" VerticalAlignment="Center"/><Button Content="KOPIUJ" Command="{Binding DataContext.CopyIdentifierCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding ObligationId}" Padding="8,4" FontSize="10"/></StackPanel>
                                                </StackPanel>
