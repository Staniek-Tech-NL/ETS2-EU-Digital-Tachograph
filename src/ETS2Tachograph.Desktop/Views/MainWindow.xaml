                                        <DataTemplate>
                                            <Border Background="#FFF4D6" BorderBrush="#D99B22"
                                                    BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,3">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#6B4300"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="CalendarWait oznacza oczekiwanie do zmiany okresu regulacyjnego. Czas może jednocześnie kwalifikować się jako odpoczynek."
                                           Foreground="#5F6874" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="▥  Raporty"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Grid><TextBlock Text="RAPORTY I STATYSTYKI" FontSize="23" FontWeight="Bold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CSV ZOBOWIĄZANIA" Command="{Binding ExportCsvCommand}"/><Button Content="PDF" Command="{Binding ExportPdfCommand}" Background="#27695E"/><Button Content="VTC JSON" Command="{Binding ExportVtcCommand}"/></StackPanel></Grid>
                <Border Grid.Row="1" Style="{StaticResource MetricCard}" Margin="0,18,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="KIEROWCA / KARTA" Foreground="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ReportDriverProfile}" DisplayMemberPath="DisplayName" Height="38" Margin="4"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="OD CZASU GRY" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding ReportFrom, UpdateSourceTrigger=PropertyChanged}" ToolTip="Np. Dzień 12, 14:30 · puste oznacza początek historii"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DO CZASU GRY" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding ReportTo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Np. Dzień 12, 18:00 · puste oznacza koniec historii"/></StackPanel><Button Grid.Column="3" Content="GENERUJ RAPORT" Command="{Binding RefreshReportCommand}" Background="#27695E" VerticalAlignment="Bottom"/></Grid></Border>
                <StackPanel Grid.Row="2">
                <Border
                        Background="#3A251E"
                        BorderBrush="#D76A4A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="6,0,6,6"
