                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="ANULUJ" Command="{Binding CancelCardCommand}"/><Button Content="POTWIERDŹ  OK" Command="{Binding ConfirmCardCommand}" Background="#27695E"/></StackPanel>
                </StackPanel>
            </Border>
        </Grid>

