                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Up" Command="{Binding AdjustDurationCommand}" CommandParameter="TightMargin|5"/><KeyBinding Key="Down" Command="{Binding AdjustDurationCommand}" CommandParameter="TightMargin|-5"/>
                                        <KeyBinding Key="PageUp" Command="{Binding AdjustDurationCommand}" CommandParameter="TightMargin|60"/><KeyBinding Key="PageDown" Command="{Binding AdjustDurationCommand}" CommandParameter="TightMargin|-60"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PlannerPresetButton}" Content="30m" Command="{Binding SetDurationPresetCommand}" CommandParameter="TightMargin|30"/><Button Style="{StaticResource PlannerPresetButton}" Content="1h" Command="{Binding SetDurationPresetCommand}" CommandParameter="TightMargin|60"/></StackPanel>
                            </StackPanel>
                            <Button Content="{localization:Localize Key=Planner_CalculateAction}" Command="{Binding CalculateCommand}" Background="#27695E" Padding="22,11" VerticalAlignment="Bottom" Margin="12,4,4,4" TabIndex="16" IsDefault="True"/>
                        </WrapPanel>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding InputOriginText}" Foreground="#5F6874" FontSize="11" Margin="0,0,0,3"/>
