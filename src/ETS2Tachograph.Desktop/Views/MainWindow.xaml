                                        <KeyBinding Key="Up" Command="{Binding AdjustDurationCommand}" CommandParameter="PostDeliveryWork|5"/><KeyBinding Key="Down" Command="{Binding AdjustDurationCommand}" CommandParameter="PostDeliveryWork|-5"/>
                                        <KeyBinding Key="PageUp" Command="{Binding AdjustDurationCommand}" CommandParameter="PostDeliveryWork|60"/><KeyBinding Key="PageDown" Command="{Binding AdjustDurationCommand}" CommandParameter="PostDeliveryWork|-60"/>
                                    </TextBox.InputBindings>
