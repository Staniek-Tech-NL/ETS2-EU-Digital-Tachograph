                    <TextBlock Text="{Binding ReportRestAllocationWarningText}" Foreground="#FFE9A8" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
                </StackPanel>
                <UniformGrid Grid.Row="3" Columns="6"><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="JAZDA" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportDriving}" FontFamily="Consolas" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="PRACA" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportWork}" FontFamily="Consolas" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="GOTOWOŚĆ" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportAvailability}" FontFamily="Consolas" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ODPOCZYNEK" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportRest}" FontFamily="Consolas" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="REKOMPENSATA" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportCompensation}" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{Binding ReportCompensationForeground}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="NARUSZENIA" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReportViolationCount}" FontFamily="Consolas" FontSize="25" FontWeight="Bold" Foreground="#FF8F8F"/></StackPanel></Border></UniformGrid>
                <DataGrid Grid.Row="4" ItemsSource="{Binding ReportRows}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="KARTA" Binding="{Binding DriverCardId}"/><DataGridTextColumn Header="OD · CZAS GRY" Binding="{Binding StartGameTimeText}"/><DataGridTextColumn Header="DO · CZAS GRY" Binding="{Binding EndGameTimeText}"/><DataGridTextColumn Header="AKTYWNOŚĆ" Binding="{Binding Activity}" Width="*"/><DataGridTextColumn Header="ŹRÓDŁO" Binding="{Binding Source}"/><DataGridTextColumn Header="WARUNEK" Binding="{Binding Condition}"/></DataGrid.Columns></DataGrid>
            </Grid></TabItem>

            <TabItem Header="♙  Kierowcy"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="PROFILE KIEROWCÓW" FontSize="23" FontWeight="Bold"/><DataGrid Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,18"><DataGrid.Columns><DataGridTextColumn Header="KIEROWCA" Binding="{Binding DisplayName}" Width="*"/><DataGridCheckBoxColumn Header="AKTYWNY" Binding="{Binding IsActive}"/><DataGridTextColumn Header="UTWORZONO" Binding="{Binding CreatedAtUtc}"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="NOWY PROFIL" Foreground="{StaticResource Muted}"/><WrapPanel><TextBox Width="240" Text="{Binding NewDriverName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nazwa kierowcy"/><TextBox Width="190" Text="{Binding NewCardNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="Numer karty"/><Button Content="DODAJ" Command="{Binding CreateProfileCommand}" Background="#27695E"/><Button Content="USTAW AKTYWNY" Command="{Binding ActivateProfileCommand}"/></WrapPanel><TextBlock Text="{Binding OperationStatus}" Foreground="#F3C969"/></StackPanel></Border></Grid></TabItem>

            <TabItem Header="⚙  Ustawienia"><StackPanel Margin="28" MaxWidth="650" HorizontalAlignment="Left"><TextBlock Text="USTAWIENIA TACHOGRAFU" FontSize="23" FontWeight="Bold"/><TextBlock Text="Parametry zostaną zastosowane przy następnym uruchomieniu." Foreground="{StaticResource Muted}" Margin="0,7,0,20"/><Border Style="{StaticResource MetricCard}" Width="600"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Próg wykrywania jazdy" FontWeight="SemiBold"/><TextBlock Text="Prędkość, od której tachograf wybiera jazdę automatycznie." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel><TextBox Grid.Column="1" Text="{Binding DrivingThreshold}"/><StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="Przesunięcie tygodnia" FontWeight="SemiBold"/><TextBlock Text="Korekta początku tygodnia regulacyjnego w dniach." Foreground="{StaticResource Muted}"/></StackPanel><TextBox Grid.Row="1" Grid.Column="1" Margin="4,22,4,4" Text="{Binding WeekOffset}"/></Grid></Border><Button Content="ZAPISZ USTAWIENIA" Command="{Binding SaveSettingsCommand}" Background="#27695E" HorizontalAlignment="Left" Padding="22,12"/><TextBlock Text="{Binding OperationStatus}" Foreground="#F3C969" TextWrapping="Wrap"/></StackPanel></TabItem>
        </TabControl>

        <Grid Grid.RowSpan="2" Background="#B0000000" Visibility="{Binding IsCardDialogVisible, Converter={StaticResource BoolToVisibility}}">
