                                <TextBox Style="{StaticResource PlannerDurationInput}" TabIndex="4" Text="{Binding OfferExpiresIn, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Up" Command="{Binding AdjustDurationCommand}" CommandParameter="OfferExpiresIn|5"/><KeyBinding Key="Down" Command="{Binding AdjustDurationCommand}" CommandParameter="OfferExpiresIn|-5"/>
                                        <KeyBinding Key="PageUp" Command="{Binding AdjustDurationCommand}" CommandParameter="OfferExpiresIn|60"/><KeyBinding Key="PageDown" Command="{Binding AdjustDurationCommand}" CommandParameter="OfferExpiresIn|-60"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PlannerPresetButton}" Content="1h" Command="{Binding SetDurationPresetCommand}" CommandParameter="OfferExpiresIn|60"/><Button Style="{StaticResource PlannerPresetButton}" Content="2h" Command="{Binding SetDurationPresetCommand}" CommandParameter="OfferExpiresIn|120"/></StackPanel>
                            </StackPanel>
                            <StackPanel Width="115" Visibility="{Binding IsMarketOffer, Converter={StaticResource BoolToVisibility}}">
