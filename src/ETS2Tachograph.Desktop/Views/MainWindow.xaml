                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{localization:Localize Key=Planner_Title}" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="{localization:Localize Key=Planner_StrategyDescription}"
                                   Foreground="#5F6874" Margin="0,5,0,0"/>
                        <TextBlock Foreground="#5F6874" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Text="{localization:Localize Key=Planner_TimeInputInstructions}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="White" BorderBrush="#B9C2CD"
                            BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,16,0,12">
                        <WrapPanel>
                            <StackPanel Width="240">
                                <TextBlock Text="{localization:Localize Key=Planner_ModeLabel}" FontSize="10" Foreground="#5F6874" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="4,9">
