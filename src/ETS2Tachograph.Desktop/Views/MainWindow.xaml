                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="KARTA" FontSize="10" Foreground="#5F6874" FontWeight="Bold"/>
                                <ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                                          DisplayMemberPath="Name" Height="38" Margin="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="JAZDA GPS · HH:MM" FontSize="10" Foreground="#5F6874" FontWeight="Bold"/>
