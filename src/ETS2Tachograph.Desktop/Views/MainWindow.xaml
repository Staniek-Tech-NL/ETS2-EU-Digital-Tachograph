                        <StackPanel><TextBlock Text="{Binding CardDialogSlotText}" FontFamily="Consolas" FontWeight="Bold" Foreground="#172016"/><TextBlock Text="{Binding SelectedProfile.DisplayName}" FontFamily="Consolas" FontSize="18" Foreground="#172016" Margin="0,5"/><TextBlock Text="WYBIERZ KRAJ" FontFamily="Consolas" Foreground="#172016"/></StackPanel>
