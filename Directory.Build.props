<Project>
  <PropertyGroup>
    <Version>0.1.0-beta.11</Version>
    <!-- Identity stays fixed so assembly references never need rebinding; the file and
         product fields carry the release the binary actually came from. -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.11.0</FileVersion>
    <InformationalVersion>0.1.0-beta.11</InformationalVersion>
  </PropertyGroup>
</Project>
