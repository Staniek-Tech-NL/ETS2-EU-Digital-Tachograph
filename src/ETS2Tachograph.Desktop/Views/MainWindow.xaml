                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{localization:Localize Key=Planner_OfferExpiresLabel}" FontSize="10" Foreground="#5F6874"/>
                                    <TextBlock Text="{Binding OfferExpiryText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{localization:Localize Key=Planner_DeliveryWindowLabel}" FontSize="10" Foreground="#5F6874"/>
